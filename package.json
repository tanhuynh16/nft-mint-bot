{
  "name": "nft-mint-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "mint-bot": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "14.0.2",
    "dotenv": "17.2.3",
    "pino": "9.13.1",
    "viem": "2.55.16",
    "yaml": "2.8.1",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/node": "22.18.9",
    "pino-pretty": "13.1.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
