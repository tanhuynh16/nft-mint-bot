[Unit]
Description=NFT mint bot scheduler
Documentation=https://github.com/tanhuynh16/nft-mint-bot
# Minting needs the network and a correct clock. A drop that opens at a precise second
# is unwinnable on a drifted clock, so the timer must be up before this starts.
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

# Stop after repeated failures instead of looping invisibly. RestartSec=10 matches
# systemd's default StartLimitIntervalSec of 10s, so restarts never accumulate inside
# the window and the burst limit never trips — which is how a fatal misconfiguration
# once looped 3278 times unnoticed and cost a scheduled drop. A unit sitting in
# `failed` is visible; an endless restart counter is not.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mintbot
Group=mintbot
WorkingDirectory=/opt/nft-mint-bot

# The private key and API key live here: owned by the service user, chmod 600. systemd
# reads it as root while starting the unit, and the same user can read it when running
# CLI commands by hand, which do not go through systemd.
EnvironmentFile=/etc/nft-mint-bot/env

ExecStart=/usr/bin/node dist/cli/index.js schedule run --config config/robinhood.yaml

# Always come back. A missed reboot is a missed drop, which is the whole reason this
# runs on a server rather than a laptop.
Restart=always
RestartSec=10

# SIGTERM lets the runner finish or cleanly abandon the current step rather than dying
# mid-transaction and leaving a job stuck in `running`. Give it room to land a receipt.
KillSignal=SIGTERM
TimeoutStopSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nft-mint-bot

# --- Hardening -------------------------------------------------------------------
# This process holds a funded hot wallet key in memory. Narrow what it can reach.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# DO NOT add MemoryDenyWriteExecute=true here.
#
# It blocks V8's JIT mprotect(W->X). V8 asserts the failure errno is ENOMEM; MDWE
# returns EPERM, the internal CHECK fails, and node aborts with SIGTRAP during
# BaselineCompiler::Build. The service then crash-loops without ever running a job.
# Every JIT runtime (node, deno, bun, JVM, PyPy) has this incompatibility. Nothing here
# can work around it short of --jitless, which is far too slow for a latency-sensitive
# mint.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# ProtectSystem=strict makes everything read-only; these two are the only paths the
# bot writes. Both must survive restarts: the journal is how an interrupted broadcast
# is recovered, the schedule is the job list itself.
ReadWritePaths=/opt/nft-mint-bot/.journal /opt/nft-mint-bot/.schedule

[Install]
WantedBy=multi-user.target
