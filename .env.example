# Copy to .env and fill THAT in. NEVER put real values in this file — it is tracked in git.
# Dedicated hot wallet only, funded with the minimum required for the mint.
PRIVATE_KEY=

# OpenSea API key (x-api-key header)
OPENSEA_API_KEY=

# Optional: OAuth bearer token with read:eligibility scope, for the eligibility endpoint
OPENSEA_BEARER_TOKEN=

# Robinhood Chain mainnet (4663)
RPC_PRIMARY=https://rpc.mainnet.chain.robinhood.com
RPC_SECONDARY=
SEQUENCER_URL=https://sequencer.mainnet.chain.robinhood.com

# Robinhood Chain testnet (46630)
TESTNET_RPC_PRIMARY=https://rpc.testnet.chain.robinhood.com
TESTNET_SEQUENCER_URL=https://sequencer.testnet.chain.robinhood.com
